; crc16.p63 - CRC-16/CCITT-FALSE, table driven
; Parameters : poly $1021, init $FFFF, MSB-first, no reflection, xorout $0000
; Check value: CRC of ASCII "123456789" = $29B1
; Public:
;   CRC16_INIT   EQU $FFFF     Starting value for a fresh CRC.
;   CRC16_BLOCK                Feed a block of bytes into a running CRC.
; CRC16_BLOCK
;   In : W = running CRC (load #CRC16_INIT to start a new one)
;        Y = address of first byte
;        X = byte count, 24-bit (0 is allowed and does nothing)
;   Out: W = updated CRC
;        Y = Y + count (so consecutive calls can chain over adjacent data)
;   Clobbers: A (so the D and Q composites), X, GP, CC. B, E/F-as-W and Y are as above.
;   Stack: about 9 bytes at the deepest point (JSR + BSR return + one saved X).
;   Speed: about 17 cycles/byte
; Streaming: call once per region and keep W between calls, e.g. to skip a field inside an image, CRC the bytes before it, CRC a zero buffer in its place, then CRC the bytes after it.
; Method: crc = (crc << 8) ^ T[(crc >> 8) ^ byte]. The 16-bit table is stored as two 256-byte tables (high bytes, low bytes) so the lookup needs no scaling; (crc << 8) leaves F in the high byte, so:
;     new E = F ^ TAB_HI[idx]        new F = TAB_LO[idx]
; Placement: INCLUDE emits bytes in sequence at the directive, so include this file inside a code/data area, not ahead of your first ORG. The table is reached with an indexed offset equal to its address, so keep it below $800000.
; Labels are global; internals are prefixed _CRC16_.

CRC16_INIT      EQU $FFFF

CRC16_BLOCK:
    CMP X,#256
    BCS _CRC16_TAIL             ; fewer than 256 bytes left (borrow)
    LEA X,-256,X                ; bytes remaining after this 256-byte block
    PUSH X
    LD GP,#0                    ; 0 means 256 iterations
    BSR _CRC16_RUN
    POP X
    BRA CRC16_BLOCK
_CRC16_TAIL:
    CMP X,#0
    BEQ _CRC16_DONE
    MOV GP,X                    ; X < 256, so the low byte is the whole count
    BSR _CRC16_RUN
_CRC16_DONE:
    RTS

; GP = byte count (0 = 256), Y = data pointer, W = CRC. Clobbers A, X, GP.
_CRC16_RUN:
    LD A,0,Y
    XOR A,E                     ; A = (crc >> 8) ^ byte = table index
    MOV X,A                     ; zero-extends 8 -> 24 bits
    LD A,CRC16_TAB_HI,X
    XOR A,F                     ; new high byte = F ^ TAB_HI[idx]
    LD F,CRC16_TAB_LO,X         ; new low byte  = TAB_LO[idx]
    MOV E,A
    INC Y
    DEC GP
    BNE _CRC16_RUN
    RTS

CRC16_TAB_HI:
    .BYTE $00,$10,$20,$30,$40,$50,$60,$70
    .BYTE $81,$91,$A1,$B1,$C1,$D1,$E1,$F1
    .BYTE $12,$02,$32,$22,$52,$42,$72,$62
    .BYTE $93,$83,$B3,$A3,$D3,$C3,$F3,$E3
