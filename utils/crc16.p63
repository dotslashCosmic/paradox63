    .BYTE $A5,$B5,$85,$95,$E5,$F5,$C5,$D5
    .BYTE $36,$26,$16,$06,$76,$66,$56,$46
    .BYTE $B7,$A7,$97,$87,$F7,$E7,$D7,$C7
    .BYTE $48,$58,$68,$78,$08,$18,$28,$38
    .BYTE $C9,$D9,$E9,$F9,$89,$99,$A9,$B9
