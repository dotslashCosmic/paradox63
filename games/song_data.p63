    .BYTE MUS_END
TWIN_7:
    .BYTE MUS_INS, I_TWIN
    .BYTE M_A6,1, M_G6,1, M_FS6,1, M_E6,1, M_DS6,1, M_C6,1, M_B5,1, M_A5,1, M_G5,1, M_FS5,1, M_E5,1, M_DS5,1, M_FS5,2, M_A5,2
    .BYTE MUS_END
TWIN_8:
    .BYTE MUS_INS, I_TWIN
    .BYTE MUS_INS, I_TWINB
    .BYTE M_DS6,8, MUS_REST,8
    .BYTE MUS_END

