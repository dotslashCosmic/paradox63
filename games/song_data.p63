; bass: the root in eighths, jumping an octave
BASS_EM:
    .BYTE MUS_INS, I_BASS
    .BYTE M_E2,2, M_E3,2, M_E2,2, M_E3,2, M_E2,2, M_E3,2, M_E2,2, M_E3,2
