    .BYTE M_E5,1, M_G5,1, M_B5,1, M_E6,1, M_G6,2, M_F6,1, M_E6,1, M_DS6,1, M_C6,1, M_B5,1, M_G5,1, M_B5,4
    .BYTE MUS_END
