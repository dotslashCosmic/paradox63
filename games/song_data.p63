; the twin guitar: a diatonic third above the solo
TWIN_1:
    .BYTE MUS_INS, I_TWIN
    .BYTE M_G5,1, M_A5,1, M_B5,1, M_DS6,1, M_G6,2, M_FS6,1, M_G6,1, M_DS6,1, M_B5,1, M_G5,1, M_DS5,1, M_G5,4
    .BYTE MUS_END
