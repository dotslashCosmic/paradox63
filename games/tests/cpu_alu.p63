; cpu_alu.p63 - loads, register pairs, add/subtract, inc/dec/neg, logic, with their flags
; Flags are worked out at the destination's width, H = carry or borrow out of bit 3.
; Flags are written H N Z V C; a "mask" lists only the flags the instruction defines.
; Run: p63-sim test games/tests/cpu_alu.p63   (or play it to see PASS / FAIL on screen)

INCLUDE "../p63_hw.inc"

ORG $000100

START:
    LD X,#NAME
    JSR T_INIT

; loads and moves set N and Z from the value; ST touches no flags

    JSR T_CASE                      ; 1: LD A,#$00 -> Z
    LD A,#$00
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z
    LD E,#M_NZ
    JSR T_FLAGS

    JSR T_CASE                      ; 2: LD A,#$80 -> N
    LD A,#$80
    PUSH CC
    LD B,#$80
    JSR T_CHECK8
    POP A
    LD B,#FL_N
    LD E,#M_NZ
    JSR T_FLAGS

    JSR T_CASE                      ; 3: LD D,#$8001 -> N (bit 15)
    LD D,#$8001
    PUSH CC
    LD W,#$8001
    JSR T_CHECK16
    POP A
    LD B,#FL_N
    LD E,#M_NZ
    JSR T_FLAGS

    JSR T_CASE                      ; 4: LD Q,#0 -> Z (all 32 bits)
    LD Q,#$00000000
    PUSH CC
    POP A
    LD B,#FL_Z
    LD E,#M_NZ
    JSR T_FLAGS

    JSR T_CASE                      ; 5: MOV A,B with B = $90 -> A = $90, N
    LD A,#$00
    LD B,#$90
    MOV A,B
    PUSH CC
    JSR T_CHECK8                    ; B still holds the want, $90
    POP A
    LD B,#FL_N
    LD E,#M_NZ
    JSR T_FLAGS

    JSR T_CASE                      ; 6: ST changes no flags: Z from LD A,#0 survives storing $55
    LD B,#$55
    LD A,#$00
    ST B,SCRATCH
    PUSH CC
    POP A
    LD B,#FL_Z
    LD E,#M_NZ
    JSR T_FLAGS

; register pairs: D = A:B, W = E:F, Q = D:W (high half first)

    JSR T_CASE                      ; 7: A = $12, B = $34 -> D = $1234
    LD A,#$12
    LD B,#$34
    LD W,#$1234
    JSR T_CHECK16

    JSR T_CASE                      ; 8: D = $ABCD -> A = $AB
    LD D,#$ABCD
    LD B,#$AB
    JSR T_CHECK8

    JSR T_CASE                      ; 9: W = $1234 -> E = $12
    LD W,#$1234
    MOV A,E
    LD B,#$12
    JSR T_CHECK8

    JSR T_CASE                      ; 10: D = $1234, W = $5678 -> Q = $12345678
    LD D,#$1234
    LD W,#$5678
    CMP Q,#$12345678
    PUSH CC
    POP A
    LD B,#FL_Z
    LD E,#M_HNZVC
    JSR T_FLAGS

; ADD / ADC

    JSR T_CASE                      ; 11: $7F + $01 = $80; F+1 carries out of bit 3 -> H; pos+pos=neg -> V; N
    LD A,#$7F
    ADD A,#$01
    PUSH CC
    LD B,#$80
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_N|FL_V
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 12: $FF + $01 = $00 carry out -> H, Z, C
    LD A,#$FF
    ADD A,#$01
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_Z|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 13: $80 + $80 = $00; 0+0 no H; neg+neg=pos -> V; Z, C
    LD A,#$80
    ADD A,#$80
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z|FL_V|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 14: $12 + $34 = $46, no flags
    LD A,#$12
    ADD A,#$34
    PUSH CC
    LD B,#$46
    JSR T_CHECK8
    POP A
    LD B,#$00
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 15: C set, $10 + $0F + 1 = $20; 0+F+1 carries out of bit 3 -> H
    SEC
    LD A,#$10                       ; LD leaves C alone
    ADC A,#$0F
    PUSH CC
    LD B,#$20
    JSR T_CHECK8
    POP A
    LD B,#FL_H
    LD E,#M_HNZVC
    JSR T_FLAGS

; SUB / SBC / CMP: C = borrow, H = borrow out of bit 3

    JSR T_CASE                      ; 16: $00 - $01 = $FF; borrow -> C, 0<1 -> H; N
    LD A,#$00
    SUB A,#$01
    PUSH CC
    LD B,#$FF
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_N|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 17: $80 - $01 = $7F; neg-pos=pos -> V; 0<1 -> H
    LD A,#$80
    SUB A,#$01
    PUSH CC
    LD B,#$7F
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_V
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 18: $05 - $05 = $00 -> Z only
    LD A,#$05
    SUB A,#$05
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 19: C set, $10 - $0F - 1 = $00 -> Z; low nibble 0-F-1 borrows -> H; no borrow out -> no C
    SEC
    LD A,#$10
    SBC A,#$0F
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_Z
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 20: CMP $40 with $41: A unchanged; $40-$41 = $FF -> N, C, H
    LD A,#$40
    CMP A,#$41
    PUSH CC
    LD B,#$40
    JSR T_CHECK8
    POP A
    LD B,#FL_H|FL_N|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

; INC / DEC: N Z V, C untouched; NEG: C set when the result isn't 0

    JSR T_CASE                      ; 21: INC $7F = $80 -> N, V
    LD A,#$7F
    INC A
    PUSH CC
    LD B,#$80
    JSR T_CHECK8
    POP A
    LD B,#FL_N|FL_V
    LD E,#M_NZV
    JSR T_FLAGS

    JSR T_CASE                      ; 22: DEC $00 = $FF -> N
    LD A,#$00
    DEC A
    PUSH CC
    LD B,#$FF
    JSR T_CHECK8
    POP A
    LD B,#FL_N
    LD E,#M_NZV
    JSR T_FLAGS

    JSR T_CASE                      ; 23: DEC $80 = $7F -> V
    LD A,#$80
    DEC A
    PUSH CC
    LD B,#$7F
    JSR T_CHECK8
    POP A
    LD B,#FL_V
    LD E,#M_NZV
    JSR T_FLAGS

    JSR T_CASE                      ; 24: INC leaves C alone: C set before, still set after
    SEC
    LD A,#$01
    INC A
    PUSH CC
    POP A
    LD B,#FL_C
    LD E,#FL_C
    JSR T_FLAGS

    JSR T_CASE                      ; 25: NEG $01 = $FF -> N, C
    LD A,#$01
    NEG A
    PUSH CC
    LD B,#$FF
    JSR T_CHECK8
    POP A
    LD B,#FL_N|FL_C
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 26: NEG $80 = $80 -> N, V, C
    LD A,#$80
    NEG A
    PUSH CC
    LD B,#$80
    JSR T_CHECK8
    POP A
    LD B,#FL_N|FL_V|FL_C
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 27: NEG $00 = $00 -> Z, no C
    LD A,#$00
    NEG A
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z
    LD E,#M_NZVC
    JSR T_FLAGS

; logic: N Z from the result, V and C cleared (C is set first to catch it)

    JSR T_CASE                      ; 28: $F0 AND $0F = $00 -> Z
    SEC
    LD A,#$F0
    AND A,#$0F
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 29: $F0 OR $0F = $FF -> N
    SEC
    LD A,#$F0
    OR A,#$0F
    PUSH CC
    LD B,#$FF
    JSR T_CHECK8
    POP A
    LD B,#FL_N
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 30: $FF XOR $0F = $F0 -> N
    SEC
    LD A,#$FF
    XOR A,#$0F
    PUSH CC
    LD B,#$F0
    JSR T_CHECK8
    POP A
    LD B,#FL_N
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 31: CLR -> $00 with N0 Z1 V0 C0
    LD A,#$55
    SEC
    CLR A
    PUSH CC
    LD B,#$00
    JSR T_CHECK8
    POP A
    LD B,#FL_Z
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 32: COM $0F = $F0 -> N, and C always set
    CLC
    LD A,#$0F
    COM A
    PUSH CC
    LD B,#$F0
    JSR T_CHECK8
    POP A
    LD B,#FL_N|FL_C
    LD E,#M_NZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 33: TST $80: A unchanged -> N, V and C cleared
    SEC
    LD A,#$80
    TST A
    PUSH CC
    LD B,#$80
    JSR T_CHECK8
    POP A
    LD B,#FL_N
    LD E,#M_NZVC
    JSR T_FLAGS

; wider registers: flags at the destination's width

    JSR T_CASE                      ; 34: D $7FFF + 1 = $8000 -> N, V, H (F+1 out of bit 3)
    LD D,#$7FFF
    ADD D,#1
    PUSH CC
    LD W,#$8000
    JSR T_CHECK16
    POP A
    LD B,#FL_H|FL_N|FL_V
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 35: W $0001 - $0002 = $FFFF -> N, C, H
    LD W,#$0001
    SUB W,#$0002
    PUSH CC
    MOV D,W
    LD W,#$FFFF
    JSR T_CHECK16
    POP A
    LD B,#FL_H|FL_N|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

    JSR T_CASE                      ; 36: Q $FFFFFFFF + 1 = 0 -> Z, C, H
    LD Q,#$FFFFFFFF
    ADD Q,#1
    PUSH CC
    POP A
    LD B,#FL_H|FL_Z|FL_C
    LD E,#M_HNZVC
    JSR T_FLAGS

    JMP T_PASS

NAME:       .BYTE "CPU ALU AND FLAGS", 0
SCRATCH:    .BYTE 0

INCLUDE "testlib.p63"
INCLUDE "font.p63"
