; stream.p63 - "Power Up", an original jingle for the frame-stream player (SONG_START, SONG_TICK)
; Every frame of every voice is spelled out: volume and pitch, one event per change.
; That makes per-frame tricks easy: a pitch sweep, a C64-style fake chord, a swelling whoosh.
; For whole songs, the note-based player (MUS_START, MUS_TICK) is far smaller: see song.p63
; Run: p63-sim play games/stream.p63

INCLUDE "p63_hw.inc"

ORG $000100

START:
    CLR A
    MOV DP,A
    JSR SND_INIT                    ; engine on; sample 0 is a square wave
    LD X,#JINGLE
    JSR SONG_START
.LOOP:
    WAITV
    JSR SONG_TICK
    BRA .LOOP

JINGLE:
    .BYTE 3                       ; tracks
    .ADDR SWEEP, SWEEP
    .BYTE 0, 0, $01                 ; voice 0, sample 0, looping wave
    .DS 15                          ; player state
    .ADDR CHORD, CHORD
    .BYTE 1, 0, $01                 ; voice 1, sample 0, looping wave
    .DS 15                          ; player state
    .ADDR WHOOSH, WHOOSH
    .BYTE 2, 0, $02                 ; voice 2, sample 0, noise
    .DS 15                          ; player state

; events: frames, volume, pitch low, pitch high (noise: rate, 0); 0 ends the list and loops
